# ═══════════════════════════════════════════════════
# Shared workspace .gitignore
# ═══════════════════════════════════════════════════

# ── Personal / machine-specific (never shared) ────
/Machine/
/temp/
# Cloned repositories live here; only AGENTS.md is versioned in the main repo
/Repos/*
!/Repos/AGENTS.md

# ── Personal knowledge bases (optional: remove a line to share yours) ──
# To keep your personal KB private, add it here:
# /Knowledge/YourName-Brain/

# ── Obsidian (vault UI state; notes stay tracked) ─
/Knowledge/David-Brain/.obsidian/workspace.json

# ── OS / editor noise ─────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Node / Python artifacts ───────────────────────
node_modules/
__pycache__/
*.pyc
.env
.env.local
